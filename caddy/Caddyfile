{
    debug   # Enables debug mode for more detailed logging
}

ai.benkalmus.com {
    # adding kokoro web ui passthrough for TTS
    handle /web* {
        reverse_proxy haproxy:8880 {
            transport http {
                versions h1 h2
            }
        }
    }

    handle {
        # running in docker container, should discover openwebui service via docker's dns
        reverse_proxy openwebui:8080 {
            transport http {
                versions h1 h2
            }
        }
    }
}

wol.benkalmus.com {
    # wake on lan service running on esprimo via wireguard
    reverse_proxy 10.10.10.3:8000
}

n8n.benkalmus.com {
    # running in docker container, should discover openwebui service via docker's dns
    reverse_proxy n8n:5678
}

flow.benkalmus.com {
    reverse_proxy flowise:3000
}

