## Portfolio Website
## =================
benkalmus.com, www.benkalmus.com {
#     log {
#         output stderr
#         level DEBUG
#         format console
#     }

    # Serve the static homepage
    handle_path /* {
        root * /app
        file_server
        try_files {path} {path}/ /index.html
    }
}

blog.benkalmus.com {
    log {
        output stderr
        level DEBUG
        format console
    }

    # Path to Static Hugo Blog
    handle {
        root * /blog
        file_server
        try_files {path} {path}/ /index.html
    }
}

api.benkalmus.com {

    reverse_proxy /api/email/submit* http://flask-email:5555 {
        transport http {
            versions 1.1
        }
    }
}

## =================
## Xray VPN
## =================
pass.benkalmus.com {
    log {
        level DEBUG
    }
    root * /app
    # tls CA.crt priv.key
    
    route /ws {
        # trim /ws path when proxy-ing
        rewrite /ws* /
        reverse_proxy xray:2001 {
            header_up Host {host}  # Pass the original Host header
            header_up X-Real-IP {remote_host}  # Pass the real client IP
            header_up X-Forwarded-For {remote_host}  # Another client IP header
            header_up X-Forwarded-Proto {scheme}  # Pass the protocol (http or https)
            header_up X-Forwarded-Port {server_port}  # Add the original port too.

            # transport http {
            #     versions h2c
            # }
        }
    }

    route {
        file_server
    }
}
