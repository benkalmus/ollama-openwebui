## =================
## Xray VPN
## =================
pass.benkalmus.com {
    log {
        level DEBUG
    }
    root * /app

    route /ws {
        reverse_proxy xray:2001 {
            header_up Host {host}  # Pass the original Host header
            header_up X-Real-IP {remote_host}  # Pass the real client IP
            header_up X-Forwarded-For {remote_host}  # Another client IP header
            header_up X-Forwarded-Proto {scheme}  # Pass the protocol (http or https)
            header_up X-Forwarded-Port {server_port}  # Add the original port too.
        }
    }

    # keeps path
    handle /sselv {
        reverse_proxy xray:2002 {
            header_up Host {http.request.host}  # Pass the original Host header
        }
    }

    route {
        file_server
    }
}
