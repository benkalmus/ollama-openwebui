benkalmus.com, www.benkalmus.com {
#     log {
#         output stderr
#         level DEBUG
#         format console
#     }

    # Serve the static homepage
    handle_path /* {
        root * /app
        file_server
        try_files {path} {path}/ /index.html
    }
}

blog.benkalmus.com {
    log {
        output stderr
        level DEBUG
        format console
    }

    # Path to Static Hugo Blog
    handle {
        root * /blog
        file_server
        try_files {path} {path}/ /index.html
    }
}

api.benkalmus.com {

    reverse_proxy /api/email/submit* http://flask-email:5555 {
        transport http {
            versions 1.1
        }
    }
}
